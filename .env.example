# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/leonn?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Required. The app refuses to start a checkout without it.
STRIPE_SECRET_KEY=sk_test_...
# Required. /api/webhook rejects every request when this is missing, because
# without it the webhook signature cannot be verified.
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---------------------------------------------------------------------------
# E-Mail (Nodemailer / SMTP) - all three are required, there are no fallbacks
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.ihr-anbieter.de
SMTP_PORT=465
SMTP_USER=info@leonnrestaurant.com
SMTP_PASS=
# Inbox that receives new reservation requests. Falls back to SMTP_USER.
ADMIN_EMAIL=info@leonnrestaurant.com

# ---------------------------------------------------------------------------
# Admin area (/admin/*) - required, there is no default passcode
# ---------------------------------------------------------------------------
# Passcode for the voucher redemption dashboard. Minimum 8 characters.
ADMIN_PASSCODE=
# Secret used to sign the admin session cookie. Minimum 32 characters.
# Generate one with: openssl rand -base64 48
# Rotating this value invalidates all active admin sessions.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Public base URL - required
# ---------------------------------------------------------------------------
# Used for Stripe redirects, reservation approval links and voucher QR codes.
# Must be configured explicitly; it is never derived from the request host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
